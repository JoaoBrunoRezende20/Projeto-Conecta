rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthed() {
      return request.auth != null;
    }

    // Produtos: leitura pública, mas apenas o lojista dono pode criar, atualizar ou deletar
    match /produtos/{produtoId} {
      allow read: if true;
      allow create: if isAuthed() && request.resource.data.lojistaId == request.auth.uid;
      allow update, delete: if isAuthed() && resource.data.lojistaId == request.auth.uid;
    }
    
    // Serviços: leitura pública, mas apenas o prestador dono pode criar, atualizar ou deletar
    match /servicos/{servicoId} {
      allow read: if true;
      allow create: if isAuthed() && request.resource.data.prestadorId == request.auth.uid;
      allow update, delete: if isAuthed() && resource.data.prestadorId == request.auth.uid;
    }

    // Categorias: leitura pública, edição restrita a usuários logados (pode ser restrito a admin no futuro)
    match /categorias/{categoriaId} {
      allow read: if true;
      allow write: if isAuthed();
    }

    // Perfil do Lojista: leitura pública, mas apenas o dono do perfil pode editar
    match /lojistas/{userId} {
      allow read: if true;
      allow write: if isAuthed() && request.auth.uid == userId;
    }

    // Perfil do Prestador de Serviços: leitura pública, apenas dono do perfil pode editar
    match /prestadorServicos/{userId} {
      allow read: if true;
      allow write: if isAuthed() && request.auth.uid == userId;
    }

    // Perfil do Usuário Comum (Cliente): o próprio usuário pode ler e editar
    match /usuarioComum/{userId} {
      allow read, write: if isAuthed() && request.auth.uid == userId;
    }
    
    // Notificações: usuários autenticados (melhoria futura: restringir ao dono)
    match /notificacoes/{docId} {
      allow read, write: if isAuthed();
    }
    
    // Pedidos: usuários autenticados (melhoria futura: restringir aos envolvidos no pedido)
    match /pedidos/{pedidoId} {
      allow read, write: if isAuthed();
    }

    // Regra padrão de segurança para as outras coleções (mantido fallback original)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
